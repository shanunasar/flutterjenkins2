pipeline {
    agent any

    environment {
        FLUTTER_HOME = 'C:\\src\\flutter'
        PATH = "${FLUTTER_HOME}\\bin;${env.PATH}"
    }

    stages {

        stage('Flutter Version') {
            steps {
                dir('flutter_application_1') {
                    bat 'flutter --version'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('flutter_application_1') {
                    bat 'flutter pub get'
                }
            }
        }

        stage('Analyze') {
            steps {
                dir('flutter_application_1') {
                    bat 'flutter analyze'
                }
            }
        }

        stage('Test') {
            steps {
                dir('flutter_application_1') {
                    bat 'flutter test'
                }
            }
        }

        stage('Build Web') {
            steps {
                dir('flutter_application_1') {
                    bat 'flutter build web --release'
                }
            }
        }
    }

    post {
        success {
            echo 'Flutter Web CI/CD pipeline completed successfully!'
        }

        failure {
            echo 'Flutter Web CI/CD pipeline failed!'
        }

        always {
            archiveArtifacts artifacts: 'flutter_application_1\\build\\web\\**',
                             allowEmptyArchive: true
        }
    }
}